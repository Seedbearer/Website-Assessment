# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (assessment abuse protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend — sending (send-only scoped key)
RESEND_API_KEY=
NOTIFICATION_EMAIL=james@seedbearerfamily.com

# Resend — contacts (separate, more-privileged key: Contacts read/write. Used to record
# PDF opt-in leads with source-attribution properties; deliberately not the same key as
# RESEND_API_KEY above, which should stay send-only)
RESEND_CONTACTS_API_KEY=

# Admin
ADMIN_EMAIL=james@seedbearerfamily.com

# TinaCMS (blog editor at /tina-admin)
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
